{
  "name": "creative-companion-react",
  "private": true,
  "version": "3.50.2",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/perf-budget.mjs",
    "build:check": "npm run build && npm run test:perf",
    "bump": "node scripts/bump-version.mjs",
    "bump:minor": "node scripts/bump-version.mjs --minor",
    "bump:major": "node scripts/bump-version.mjs --major",
    "analyze": "ANALYZE=1 npm run build"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.2.20",
    "@sentry/react": "^10.67.0",
    "@sentry/tracing": "^7.120.4",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lottie-web": "^5.12.2",
    "lucide-react": "^1.26.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.9.0",
    "pdfjs-dist": "^6.2.108",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "tesseract.js@7.0.0": true,
    "esbuild@0.28.1": true
  }
}
